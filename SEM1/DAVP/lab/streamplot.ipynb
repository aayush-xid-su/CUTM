   "source": [
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "x = np.linspace(-5, 5, 20)\n",
    "y = np.linspace(-5, 5, 20)\n",
    "\n",
    "X, Y = np.meshgrid(x, y)\n",
    "\n",
    "U = -Y\n",
    "V = X\n",
    "\n",
    "plt.streamplot(X, Y, U, V, density=1.5, color='blue')\n",
    "\n",
    "plt.title(\"Streamplot\")\n",
    "plt.xlabel(\"X Axis\")\n",
    "plt.ylabel(\"Y Axis\")\n",
    "\n",
    "plt.show()"
   ]
  }
 ],
