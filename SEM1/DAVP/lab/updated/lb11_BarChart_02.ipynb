    "import plotly.express as px\n",
    "\n",
    "df = px.data.gapminder()\n",
    "df = df[df[\"year\"] == 2007]\n",
    "\n",
    "fig = px.bar(df, x=\"continent\",y=\"pop\", color=\"continent\",hover_data=[\"country\"],title=\"Advanced Population Bar Chart\")\n",
    "fig.show()"
   ]
  }
