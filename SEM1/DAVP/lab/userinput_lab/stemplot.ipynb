   "source": [
    "import matplotlib.pyplot as plt\n",
    "\n",
    "x = [1, 2, 3, 4, 5, 6, 7, 8]\n",
    "y = [10, 20, 15, 30, 25, 40, 35, 50]\n",
    "\n",
    "plt.stem(x, y)\n",
    "\n",
    "plt.title(\"Stem Plot\")\n",
    "plt.xlabel(\"X Values\")\n",
    "plt.ylabel(\"Y Values\")\n",
    "plt.grid(True)\n",
    "plt.show()"
   ]
  }
