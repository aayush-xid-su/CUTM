    "categories = ['Python', 'Java', 'C', 'C++', 'HTML']\n",
    "values = [30, 20, 15, 20, 15]\n",
    "\n",
    "plt.pie(values, labels=categories, startangle=90, shadow=True)\n",
    "\n",
    "plt.title(\"Pie Chart\")\n",
    "\n",
    "plt.show()"
