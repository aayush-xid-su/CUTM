   "source": [
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "x, y = np.meshgrid(np.linspace(0, 5, 20),\n",
    "                   np.linspace(0, 3, 20))\n",
    "\n",
    "u = -y\n",
    "v = x\n",
    "\n",
    "plt.streamplot(x, y, u, v)\n",
    "plt.title(\"Iris Streamplot\")\n",
    "plt.xlabel(\"X Axis\")\n",
    "plt.ylabel(\"Y Axis\")\n",
    "plt.show()"
   ]
  }
 ],
